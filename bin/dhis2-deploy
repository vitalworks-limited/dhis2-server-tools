#!/usr/bin/env bash
# USAGE_START
# dhis2-deploy - deployment orchestration (section 11, 57.1).
#
# Usage:
#   dhis2-deploy architectures
#   dhis2-deploy init          [--architecture lxd|distributed|hybrid]
#   dhis2-deploy preflight     [--json]
#   dhis2-deploy plan          [--only COMPONENT] [--skip COMPONENT]
#   dhis2-deploy diff          [--only COMPONENT]
#   dhis2-deploy apply         [--only COMPONENT] [--skip COMPONENT]
#                              [--limit HOST] [--instance NAME]
#                              [--preserve-dhis-conf | --merge-dhis-conf | --replace-dhis-conf]
#                              [--preserve-postgres-conf]
#                              [--no-package-upgrades | --allow-package-upgrades]
#                              [--skip-war-deploy] [--skip-restart]
#                              [--database-upgrade-mode refuse|detect|prompt|auto|force]
#                              [--source-dhis2-version VERSION] [--target-dhis2-version VERSION]
#                              [--backup-before-migration] [--no-backup-before-migration]
#                              [--verify-backup] [--monitor-migrations]
#                              [--allow-db-migrations | --no-db-migrations]
#                              [--yes]
#   dhis2-deploy verify        [--instance NAME]
#   dhis2-deploy snapshot
#   dhis2-deploy show
#   dhis2-deploy components
#   dhis2-deploy history
#   dhis2-deploy resume
#   dhis2-deploy migrate boombox-to-lxd [--dry-run | --execute --yes]
#                                       [--instance NAME]
#
# All operations preserve the existing Ansible tag/role model.
# USAGE_END
set -Eeuo pipefail

. "$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")/.." && pwd)/lib/common.sh"

# --- component → tag map (section 57.1 Component-level execution)
declare -A COMPONENT_TAGS=(
    [database]=postgresql-install
    [proxy]=proxy-install
    [monitoring]=monitoring
    [instance]=create-instance
    [alerting]=alerting
    [backup]=backup-script
    [doris]=doris-install
    [unattended-upgrades]=unattended-upgrades
    [war]=deploy-war
    [proxy-conf]=proxy-conf
    [set-url]=set-dhis2-url
)

ONLY=""
SKIP=""
DHIS_CONF_MODE=""   # preserve|merge|replace
PG_CONF_MODE=""     # preserve|merge|replace
PKG_UPGRADES="default"  # default|allow|no
SKIP_WAR=false
SKIP_RESTART=false
DB_UPGRADE_MODE=""   # refuse|detect|prompt|auto|force
DB_MIGRATIONS=""     # allow|no
SRC_VERSION=""
TGT_VERSION=""
BACKUP_BEFORE_MIG=""   # true|false
VERIFY_BACKUP=false
MONITOR_MIG=false
MIG_TIMEOUT=""
RESTORE_ON_FAIL=false

main() {
    dhis2_cli_parse_globals "$@"
    set -- "${DHIS2_CLI_REMAINING[@]}"
    [[ $# -eq 0 ]] && { dhis2_cli_show_help "$0"; exit "$DHIS2_EXIT_USAGE"; }
    local sub="$1"; shift
    case "$sub" in
        architectures) _architectures ;;
        init) _init "$@" ;;
        preflight) _preflight ;;
        migrate) _migrate "$@" ;;
        plan) _parse_apply_flags "$@"; _plan ;;
        diff) _parse_apply_flags "$@"; _diff ;;
        apply) _parse_apply_flags "$@"; _apply ;;
        verify) _verify "$@" ;;
        snapshot) _snapshot ;;
        show) _show ;;
        components) _components ;;
        history) _history ;;
        resume) _resume ;;
        --help|-h|help) dhis2_cli_show_help "$0"; exit 0 ;;
        *) dhis2_log_error "Unknown subcommand: $sub"; exit "$DHIS2_EXIT_USAGE" ;;
    esac
}

_architectures() {
    if [[ "$DHIS2_OPT_JSON" == true ]]; then
        dhis2_json_emit \
            command=dhis2-deploy \
            architectures='[{"name":"lxd","state":"SUPPORTED"},{"name":"distributed","state":"SUPPORTED"},{"name":"hybrid","state":"SUPPORTED"},{"name":"boombox","state":"SUPPORTED"},{"name":"docker","state":"NOT IMPLEMENTED"},{"name":"kubernetes","state":"NOT IMPLEMENTED"}]'
        return 0
    fi
    dhis2_output_table "ARCHITECTURE|STATE" \
        "lxd|SUPPORTED" \
        "distributed|SUPPORTED" \
        "hybrid|SUPPORTED" \
        "boombox|SUPPORTED" \
        "docker|NOT IMPLEMENTED" \
        "kubernetes|NOT IMPLEMENTED"
}

_init() {
    local arch=lxd mode=""
    local fqdn="" email="" timezone="Africa/Nairobi"
    while (( $# )); do
        case "$1" in
            --architecture) arch="${2:-lxd}"; shift ;;
            --architecture=*) arch="${1#*=}" ;;
            --mode) mode="${2:-}"; shift ;;
            --mode=*) mode="${1#*=}" ;;
            --fqdn) fqdn="${2:-}"; shift ;;
            --fqdn=*) fqdn="${1#*=}" ;;
            --email) email="${2:-}"; shift ;;
            --email=*) email="${1#*=}" ;;
            --timezone) timezone="${2:-}"; shift ;;
            --timezone=*) timezone="${1#*=}" ;;
            *) dhis2_log_warn "Ignoring: $1" ;;
        esac
        shift || true
    done
    local inv_dir="${DHIS2_CLI_ROOT}/deploy/inventory"
    local inv="$inv_dir/hosts"
    if [[ -f "$inv" ]]; then
        dhis2_log_warn "Inventory already exists: $inv (not overwriting)"
        return 0
    fi

    case "$arch" in
        boombox)
            _init_boombox "$inv" "$mode" "$fqdn" "$email" "$timezone"
            ;;
        lxd|distributed|hybrid)
            cp "$inv_dir/hosts.template" "$inv"
            ;;
        *)
            dhis2_log_error "Unknown --architecture: $arch (supported: lxd, distributed, hybrid, boombox)"
            exit "$DHIS2_EXIT_USAGE"
            ;;
    esac
    chown "${SUDO_USER:-$USER}" "$inv" 2>/dev/null || true
    chmod 600 "$inv"
    dhis2_log_info "Created $inv for architecture=$arch (edit this file next)"
}

# Boombox inventory writer. Section 6 of docs/vital-enhancements/boombox-plan.md.
_init_boombox() {
    local inv="$1" mode="$2" fqdn="$3" email="$4" timezone="$5"

    # Prompt for mode when interactive and not supplied.
    if [[ -z "$mode" ]] && [[ -t 0 ]]; then
        printf 'Boombox mode?\n  1) production  - fqdn + email required, Let'"'"'s Encrypt, hardened preflight\n  2) workshop    - self-signed, warnings over failures, fast setup\nChoice [1]: ' >&2
        local reply=""; read -r reply || true
        case "${reply:-1}" in
            2|workshop) mode=workshop ;;
            *) mode=production ;;
        esac
    fi
    [[ -z "$mode" ]] && mode=production
    case "$mode" in production|workshop) ;;
        *) dhis2_log_error "--mode must be production or workshop"; exit "$DHIS2_EXIT_USAGE" ;;
    esac

    if [[ "$mode" == "production" ]]; then
        [[ -z "$fqdn" ]]  && { dhis2_log_error "boombox production mode requires --fqdn FQDN"; exit "$DHIS2_EXIT_USAGE"; }
        [[ -z "$email" ]] && { dhis2_log_error "boombox production mode requires --email ADDR"; exit "$DHIS2_EXIT_USAGE"; }
    fi

    cat > "$inv" <<EOF
#
# Boombox inventory - every service on 127.0.0.1 (ansible_connection=local).
# Generated by dhis2-deploy init --architecture boombox --mode $mode.
# See docs/Boombox.md.
#
127.0.0.1 ansible_connection=local

[web]
127.0.0.1

[databases]
127.0.0.1

[instances]
hmis  ansible_host=127.0.0.1  database_host=127.0.0.1  dhis2_version=2.43${fqdn:+  fqdn=$fqdn}

[monitoring]
127.0.0.1

[backup_servers]
127.0.0.1

[integration]
# empty by default on boombox

[all:vars]
dhis2_architecture=boombox
boombox_mode=$mode
EOF
    [[ -n "$fqdn"  ]] && printf 'fqdn=%s\n' "$fqdn"  >> "$inv"
    [[ -n "$email" ]] && printf 'email=%s\n' "$email" >> "$inv"
    cat >> "$inv" <<EOF
timezone=$timezone
# Boombox always runs locally; connection is never ssh/lxd.
ansible_connection=local
# Default proxy on boombox is nginx (operator can change to apache2/openresty).
proxy=nginx
# Default monitoring stack. Switch to prometheus or grafana/prometheus if preferred.
server_monitoring=munin
EOF
}

_preflight() {
    local inv findings=() rc=0 warnings=()
    inv=$(dhis2_config_resolve_inventory)
    local u; u=$(dhis2_validate_ubuntu_release) || findings+=("os: $u")
    dhis2_validate_ansible_present || findings+=("ansible-playbook: missing")
    dhis2_validate_python_present || findings+=("python3: missing")
    [[ -r "$inv" ]] || findings+=("inventory: unreadable $inv")
    dhis2_inventory_validate_syntax "$inv" >/dev/null 2>&1 || findings+=("inventory syntax: invalid")
    local dupes
    dupes=$(dhis2_validate_inventory_duplicates "$inv" || true)
    [[ -n "$dupes" ]] && findings+=("duplicate hosts: $dupes")
    dhis2_validate_database_refs "$inv" >/dev/null || findings+=("unresolved database_host references")
    local p; p=$(dhis2_validate_proxy_choice "$inv")
    [[ "$p" == invalid:* ]] && findings+=("$p")
    # LXD if any lxd host present
    if grep -qE 'ansible_connection=lxd' "$inv" || grep -qE '^[[:space:]]*ansible_connection[[:space:]]*=[[:space:]]*lxd' "$inv"; then
        dhis2_validate_lxd_present || findings+=("lxd: not installed")
    fi

    # Boombox-specific preflight. Section 11 of
    # docs/vital-enhancements/boombox-plan.md.
    if grep -qE '^[[:space:]]*dhis2_architecture[[:space:]]*=[[:space:]]*boombox' "$inv"; then
        local bb_mode
        bb_mode=$(awk -F= '/^[[:space:]]*boombox_mode[[:space:]]*=/ {gsub(/[[:space:]]/,"",$2); print $2; exit}' "$inv")
        bb_mode="${bb_mode:-production}"

        # Rule 13: boombox refuses dhis2_ha=true (one host is one failure domain).
        if grep -qE '^[[:space:]]*dhis2_ha[[:space:]]*=[[:space:]]*(true|yes|1|True)' "$inv"; then
            findings+=("boombox: dhis2_ha=true is incompatible with dhis2_architecture=boombox (one host is one failure domain)")
        fi

        # Rule 1: LXD must not be installed (locked decision 3).
        if command -v lxc >/dev/null 2>&1; then
            findings+=("boombox: LXD is installed on this host. Either use dhis2_architecture=lxd OR purge LXD first (locked decision 3)")
        fi

        # Rules 9-12: ports 80/443/5432/8080 free.
        local bb_port
        for bb_port in 80 443 5432 8080; do
            if command -v ss >/dev/null 2>&1 && ss -tnlp 2>/dev/null | awk '{print $4}' | grep -qE ":${bb_port}\$"; then
                findings+=("boombox: port $bb_port is already in use on this host; stop the existing listener before deploy")
            fi
        done

        # Rules 2 + 3: production mode requires fqdn + email.
        if [[ "$bb_mode" == "production" ]]; then
            local bb_fqdn bb_email
            bb_fqdn=$(awk -F= '/^[[:space:]]*fqdn[[:space:]]*=/ {gsub(/[[:space:]]/,"",$2); print $2; exit}' "$inv")
            bb_email=$(awk -F= '/^[[:space:]]*email[[:space:]]*=/ {gsub(/[[:space:]]/,"",$2); print $2; exit}' "$inv")
            [[ -z "$bb_fqdn"  ]] && findings+=("boombox production mode: fqdn must be set")
            [[ -z "$bb_email" ]] && findings+=("boombox production mode: email must be set (Let's Encrypt)")
        fi

        # Rule 8: production mode requires UFW enabled.
        if [[ "$bb_mode" == "production" ]]; then
            local bb_ufw=""
            if command -v ufw >/dev/null 2>&1; then
                bb_ufw=$(ufw status 2>/dev/null | awk '/Status:/ {print $2}')
            fi
            [[ "$bb_ufw" != "active" ]] && findings+=("boombox production mode: ufw must be enabled (current: ${bb_ufw:-not-installed})")
        fi

        # Rules 4-6: resource warnings (locked decision 1: warn only).
        local bb_ram_mb bb_nproc bb_root_gb
        if [[ -r /proc/meminfo ]]; then
            bb_ram_mb=$(awk '/MemTotal:/ {printf "%d", $2/1024}' /proc/meminfo)
            [[ -n "$bb_ram_mb" && "$bb_ram_mb" -lt 4096 ]] && warnings+=("boombox: ${bb_ram_mb} MiB RAM (<4 GiB recommended)")
        fi
        bb_nproc=$(nproc 2>/dev/null || echo 0)
        [[ "$bb_nproc" -gt 0 && "$bb_nproc" -lt 2 ]] && warnings+=("boombox: ${bb_nproc} CPU core (<2 cores recommended)")
        if df -BG --output=avail / >/dev/null 2>&1; then
            bb_root_gb=$(df -BG --output=avail / 2>/dev/null | tail -1 | tr -dc '0-9')
            [[ -n "$bb_root_gb" && "$bb_root_gb" -lt 50 ]] && warnings+=("boombox: root FS has ${bb_root_gb} GiB free (<50 GiB recommended)")
        fi
    fi

    # HA cross-host rules (section 15b of the HA plan). Only fire when
    # the inventory opts into HA. These are HARD failures, not warnings
    # - 3 etcd on the same physical host is not real HA. The parsing
    # reads the INI directly so it works on controllers without
    # ansible-inventory available (installer-prepare path).
    if grep -qE '^[[:space:]]*dhis2_ha[[:space:]]*=[[:space:]]*(true|yes|1|True)' "$inv"; then
        local etcd_count etcd_distinct
        # Rule 1: >=3 etcd members on 3 distinct physical_host
        etcd_count=$(awk '
            /^\[.*\]/ { section=substr($0,2,length($0)-2); next }
            section=="etcd" && !/^#/ && NF>0 { c++ }
            END { print c+0 }
        ' "$inv")
        etcd_distinct=$(awk '
            /^\[.*\]/ { section=substr($0,2,length($0)-2); next }
            section=="etcd" && !/^#/ && NF>0 {
                for (i=1;i<=NF;i++) {
                    if ($i ~ /^physical_host=/) {
                        split($i,a,"="); print a[2]
                    }
                }
            }
        ' "$inv" | sort -u | grep -c '[^[:space:]]' || true)
        if (( etcd_count < 3 )); then
            findings+=("ha: [etcd] has $etcd_count member(s); 3 required (section 15b)")
        elif (( etcd_distinct < 3 )); then
            findings+=("ha: 3 etcd members must span 3 distinct physical_host (found $etcd_distinct; set the physical_host host var)")
        fi

        # Rule 2: primary + sync_standby on distinct physical_host
        local primary_phys sync_phys
        primary_phys=$(awk '
            /^\[.*\]/ { section=substr($0,2,length($0)-2); next }
            section=="databases" && !/^#/ && NF>0 {
                is_primary=0; phys=""
                for (i=1;i<=NF;i++) {
                    if ($i == "ha_role=primary") is_primary=1
                    if ($i ~ /^physical_host=/) { split($i,a,"="); phys=a[2] }
                }
                if (is_primary) print phys
            }
        ' "$inv" | head -1)
        sync_phys=$(awk '
            /^\[.*\]/ { section=substr($0,2,length($0)-2); next }
            section=="databases" && !/^#/ && NF>0 {
                is_sync=0; phys=""
                for (i=1;i<=NF;i++) {
                    if ($i == "ha_pg_sync_standby=true") is_sync=1
                    if ($i ~ /^physical_host=/) { split($i,a,"="); phys=a[2] }
                }
                if (is_sync) print phys
            }
        ' "$inv" | head -1)
        if [[ -n "$primary_phys" && -n "$sync_phys" && "$primary_phys" == "$sync_phys" ]]; then
            findings+=("ha: primary and sync-replica share physical_host '$primary_phys' - no HA against host failure")
        fi
    fi

    # Section 11.3 additions: DNS, disk, RAM, CPU. All treated as warnings
    # rather than hard failures because they may be true positives in
    # transient conditions (DNS flap, mid-dump disk pressure, etc.) and
    # the operator sometimes knows better. The thresholds are overridable
    # via environment variables.
    local fqdn
    fqdn=$(awk -F= '/^[[:space:]]*fqdn[[:space:]]*=/ {gsub(/[[:space:]]/,"",$2); print $2; exit}' "$inv")
    if [[ -n "$fqdn" ]]; then
        if ! getent ahosts "$fqdn" >/dev/null 2>&1 && ! host "$fqdn" >/dev/null 2>&1; then
            warnings+=("dns: $fqdn does not resolve from this controller (TLS/HTTP checks will fail)")
        fi
    fi
    local disk_min_gb="${DHIS2_PREFLIGHT_DISK_MIN_GB:-10}"
    local root_free_gb=""
    if df -BG --output=avail / >/dev/null 2>&1; then
        root_free_gb=$(df -BG --output=avail / 2>/dev/null | tail -1 | tr -dc '0-9')
    elif df -g / >/dev/null 2>&1; then
        # macOS / BSD fallback
        root_free_gb=$(df -g / 2>/dev/null | tail -1 | awk '{print $4}')
    fi
    if [[ -n "$root_free_gb" && "$root_free_gb" =~ ^[0-9]+$ ]] && (( root_free_gb < disk_min_gb )); then
        warnings+=("disk: controller / has ${root_free_gb}G free (threshold ${disk_min_gb}G)")
    fi
    local ram_min_mb="${DHIS2_PREFLIGHT_RAM_MIN_MB:-2048}"
    local ram_mb=""
    if [[ -r /proc/meminfo ]]; then
        ram_mb=$(awk '/MemTotal:/ {printf "%d", $2/1024}' /proc/meminfo 2>/dev/null)
    elif command -v sysctl >/dev/null; then
        local b; b=$(sysctl -n hw.memsize 2>/dev/null || echo 0)
        ram_mb=$(( b / 1024 / 1024 ))
    fi
    if [[ -n "$ram_mb" && "$ram_mb" =~ ^[0-9]+$ ]] && (( ram_mb < ram_min_mb )); then
        warnings+=("memory: controller has ${ram_mb}MB total RAM (threshold ${ram_min_mb}MB)")
    fi
    local cpu_min="${DHIS2_PREFLIGHT_CPU_MIN:-2}"
    local nproc=""
    nproc=$(nproc 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo "")
    if [[ -n "$nproc" && "$nproc" =~ ^[0-9]+$ ]] && (( nproc < cpu_min )); then
        warnings+=("cpu: controller has ${nproc} core(s) (threshold ${cpu_min})")
    fi

    (( ${#findings[@]} )) && rc=$DHIS2_EXIT_PREFLIGHT
    if [[ "$DHIS2_OPT_JSON" == true ]]; then
        local arr="[" first=true f
        for f in "${findings[@]:-}"; do
            [[ -z "$f" ]] && continue
            $first || arr+=","
            first=false
            local safe="${f//\"/\\\"}"
            arr+="\"$safe\""
        done
        arr+="]"
        local warn_arr="[" first=true f
        for f in "${warnings[@]:-}"; do
            [[ -z "$f" ]] && continue
            $first || warn_arr+=","; first=false
            local safe="${f//\"/\\\"}"
            warn_arr+="\"$safe\""
        done
        warn_arr+="]"
        local succ; if (( rc == 0 )); then succ=true; else succ=false; fi
        dhis2_json_emit command=dhis2-deploy action=preflight success="$succ" findings="$arr" warnings="$warn_arr"
    else
        if (( rc == 0 )); then
            dhis2_status_ok "OK"; echo " - preflight passed"
        else
            dhis2_status_fail "FAIL"; echo " - findings:"
            local f
            for f in "${findings[@]}"; do printf '  - %s\n' "$f"; done
        fi
        if (( ${#warnings[@]} )); then
            local w
            for w in "${warnings[@]}"; do dhis2_c_yellow "warn"; printf '  %s\n' "$w"; done
        fi
    fi
    exit $rc
}

_parse_apply_flags() {
    while (( $# )); do
        case "$1" in
            --only) ONLY="${2:-}"; shift ;;
            --only=*) ONLY="${1#*=}" ;;
            --skip) SKIP="${2:-}"; shift ;;
            --skip=*) SKIP="${1#*=}" ;;
            --preserve-dhis-conf) DHIS_CONF_MODE=preserve ;;
            --merge-dhis-conf)    DHIS_CONF_MODE=merge ;;
            --replace-dhis-conf)  DHIS_CONF_MODE=replace ;;
            --preserve-postgres-conf) PG_CONF_MODE=preserve ;;
            --allow-package-upgrades) PKG_UPGRADES=allow ;;
            --no-package-upgrades)    PKG_UPGRADES=no ;;
            --skip-war-deploy) SKIP_WAR=true ;;
            --skip-restart) SKIP_RESTART=true ;;
            --database-upgrade-mode) DB_UPGRADE_MODE="${2:-}"; shift ;;
            --database-upgrade-mode=*) DB_UPGRADE_MODE="${1#*=}" ;;
            --allow-db-migrations) DB_MIGRATIONS=allow ;;
            --no-db-migrations)    DB_MIGRATIONS=no ;;
            --source-dhis2-version) SRC_VERSION="${2:-}"; shift ;;
            --source-dhis2-version=*) SRC_VERSION="${1#*=}" ;;
            --target-dhis2-version) TGT_VERSION="${2:-}"; shift ;;
            --target-dhis2-version=*) TGT_VERSION="${1#*=}" ;;
            --backup-before-migration) BACKUP_BEFORE_MIG=true ;;
            --no-backup-before-migration) BACKUP_BEFORE_MIG=false ;;
            --verify-backup) VERIFY_BACKUP=true ;;
            --monitor-migrations) MONITOR_MIG=true ;;
            --migration-timeout) MIG_TIMEOUT="${2:-}"; shift ;;
            --migration-timeout=*) MIG_TIMEOUT="${1#*=}" ;;
            --restore-on-failure) RESTORE_ON_FAIL=true ;;
            --) shift; break ;;
            *) dhis2_log_warn "Ignoring unknown apply option: $1" ;;
        esac
        shift || true
    done
}

_resolve_tags() {
    local -a tags=()
    if [[ -n "$ONLY" ]]; then
        IFS=',' read -r -a parts <<< "$ONLY"
        local p
        for p in "${parts[@]}"; do
            if [[ -n "${COMPONENT_TAGS[$p]:-}" ]]; then
                tags+=("${COMPONENT_TAGS[$p]}")
            else
                dhis2_log_error "Unknown component: $p"
                exit "$DHIS2_EXIT_USAGE"
            fi
        done
    fi
    $SKIP_WAR && :
    $SKIP_RESTART && :
    (IFS=,; echo "${tags[*]}")
}

_resolve_skip_tags() {
    local -a tags=()
    if [[ -n "$SKIP" ]]; then
        IFS=',' read -r -a parts <<< "$SKIP"
        local p
        for p in "${parts[@]}"; do
            [[ -n "${COMPONENT_TAGS[$p]:-}" ]] && tags+=("${COMPONENT_TAGS[$p]}")
        done
    fi
    $SKIP_WAR && tags+=(deploy-war)
    (IFS=,; echo "${tags[*]}")
}

_extra_vars() {
    local -a kv=()
    [[ -n "$DHIS_CONF_MODE" ]] && kv+=("dhis2_conf_mode=$DHIS_CONF_MODE")
    [[ -n "$PG_CONF_MODE"   ]] && kv+=("postgres_conf_mode=$PG_CONF_MODE")
    [[ -n "$DB_UPGRADE_MODE" ]] && kv+=("dhis2_database_upgrade_mode=$DB_UPGRADE_MODE")
    [[ -n "$SRC_VERSION" ]] && kv+=("dhis2_source_version=$SRC_VERSION")
    [[ -n "$TGT_VERSION" ]] && kv+=("dhis2_version=$TGT_VERSION")
    case "$PKG_UPGRADES" in
        allow) kv+=("dhis2_allow_package_upgrades=true") ;;
        no)    kv+=("dhis2_allow_package_upgrades=false") ;;
    esac
    [[ "$BACKUP_BEFORE_MIG" == "true"  ]] && kv+=("dhis2_backup_before_migration=true")
    [[ "$BACKUP_BEFORE_MIG" == "false" ]] && kv+=("dhis2_backup_before_migration=false")
    $VERIFY_BACKUP && kv+=("dhis2_verify_backup=true")
    $MONITOR_MIG   && kv+=("dhis2_monitor_migrations=true")
    if [[ -n "$DB_MIGRATIONS" ]]; then
        if [[ "$DB_MIGRATIONS" == "allow" ]]; then kv+=("dhis2_allow_db_migrations=true"); else kv+=("dhis2_allow_db_migrations=false"); fi
    fi
    $SKIP_WAR && kv+=("dhis2_skip_war_deploy=true")
    $SKIP_RESTART && kv+=("dhis2_skip_restart=true")
    [[ -n "$MIG_TIMEOUT" ]] && kv+=("dhis2_migration_timeout=$MIG_TIMEOUT")
    $RESTORE_ON_FAIL && kv+=("dhis2_restore_on_failure=true")
    local out
    out=$(printf '%s ' "${kv[@]:-}")
    [[ -z "$out" ]] && return 0
    printf -- '-e %s' "$out"
}

_plan() {
    DHIS2_OPT_CHECK=true; DHIS2_OPT_DIFF=true
    export DHIS2_OPT_CHECK DHIS2_OPT_DIFF
    _apply --plan-only
}

_diff() {
    DHIS2_OPT_CHECK=true; DHIS2_OPT_DIFF=true
    export DHIS2_OPT_CHECK DHIS2_OPT_DIFF
    _apply --plan-only
}

_apply() {
    local plan_only=false
    [[ "${1:-}" == "--plan-only" ]] && plan_only=true

    # Preflight is required for apply unless --yes AND --no-check-preflight
    if ! $plan_only; then
        dhis2_log_info "Running preflight"
        if ! ( DHIS2_OPT_JSON=false; _preflight ) >/dev/null; then
            dhis2_log_error "Preflight failed - aborting apply (use dhis2-deploy preflight for details)"
            exit "$DHIS2_EXIT_PREFLIGHT"
        fi
    fi

    local lock_name="deploy"
    [[ -n "${DHIS2_OPT_INSTANCE:-}" ]] && lock_name="deploy.${DHIS2_OPT_INSTANCE}"
    dhis2_lock_acquire "$lock_name" || exit $?

    local tags skip_tags
    tags=$(_resolve_tags)
    skip_tags=$(_resolve_skip_tags)

    local -a extra=()
    local ev
    ev=$(_extra_vars) || true
    [[ -n "$ev" ]] && read -r -a extra <<< "$ev"

    local -a ans_args=()
    [[ -n "$tags" ]]     && ans_args+=(--tags "$tags")
    [[ -n "$skip_tags" ]] && ans_args+=(--skip-tags "$skip_tags")
    [[ -n "${DHIS2_OPT_INSTANCE:-}" ]] && ans_args+=(--limit "$DHIS2_OPT_INSTANCE")

    local history_dir rec
    history_dir=$(dhis2_config_history_dir)
    rec="$history_dir/apply.$(date -u +%Y%m%d-%H%M%S).log"
    dhis2_log_info "Recording run to $rec"

    local started; started=$(date -u +%s)
    local rc=0
    set +e
    ANSIBLE_CONFIG="$(dhis2_ansible_cfg)" \
      dhis2_ansible_playbook dhis2.yml "${extra[@]:-}" "${ans_args[@]:-}" 2>&1 | tee "$rec"
    rc=${PIPESTATUS[0]}
    set -e

    local ended; ended=$(date -u +%s)
    dhis2_log_audit dhis2-deploy "{\"only\":\"$ONLY\",\"skip\":\"$SKIP\",\"instance\":\"${DHIS2_OPT_INSTANCE:-}\",\"dhis_conf_mode\":\"$DHIS_CONF_MODE\",\"db_upgrade_mode\":\"$DB_UPGRADE_MODE\",\"plan_only\":$plan_only}" \
        "rc=$rc,duration=$((ended-started))"

    if (( rc != 0 )); then
        dhis2_log_error "Deployment failed (rc=$rc). Transcript: $rec"
        exit "$DHIS2_EXIT_ANSIBLE"
    fi

    if ! $plan_only; then
        dhis2_log_info "Running post-deployment verification"
        _verify >/dev/null 2>&1 || dhis2_log_warn "Post-deployment verification reported issues."
    fi

    if [[ "$DHIS2_OPT_JSON" == true ]]; then
        dhis2_json_emit command=dhis2-deploy action="$([[ $plan_only == true ]] && echo plan || echo apply)" success=true duration="$((ended-started))" record="$rec"
    else
        dhis2_log_info "Deployment completed in $((ended-started))s"
    fi
}

_verify() {
    local inst="${DHIS2_OPT_INSTANCE:-}"
    local target="all"
    [[ -n "$inst" ]] && target="$inst"
    # Minimal verification: ask Ansible to collect service facts; stop if unreachable.
    if ! command -v ansible >/dev/null 2>&1; then
        dhis2_log_warn "ansible not installed - skipping verification"
        return 0
    fi
    local rc=0
    dhis2_ansible_adhoc "$target" ping -o 2>&1 || rc=$?
    if (( rc != 0 )); then
        dhis2_log_error "Verification: host unreachable: $target"
        exit "$DHIS2_EXIT_CONNECTIVITY"
    fi
    dhis2_log_info "Verification: hosts reachable."
}

_snapshot() {
    local out
    out="$(dhis2_config_snapshot_dir)/snap-$(date -u +%Y%m%d-%H%M%S)"
    mkdir -p "$out"
    chmod 700 "$out"
    local inv deploy_dir
    inv=$(dhis2_config_resolve_inventory)
    deploy_dir=$(dhis2_config_deploy_dir)
    cp -a "$inv" "$out/hosts"
    [[ -d "$deploy_dir/inventory/host_vars" ]] && cp -a "$deploy_dir/inventory/host_vars" "$out/host_vars"
    [[ -d "$deploy_dir/inventory/group_vars" ]] && cp -a "$deploy_dir/inventory/group_vars" "$out/group_vars"
    echo "$DHIS2_CLI_VERSION" > "$out/TOOL_VERSION"
    date -u +%FT%TZ > "$out/TIMESTAMP"
    chmod -R go-rwx "$out"
    dhis2_log_info "Snapshot: $out"
    [[ "$DHIS2_OPT_JSON" == true ]] && dhis2_json_emit snapshot="$out"
}

_show() {
    local inv; inv=$(dhis2_config_resolve_inventory)
    local arch=lxd
    grep -qE 'ansible_connection=ssh' "$inv" && arch=distributed
    if grep -qE 'ansible_connection=lxd' "$inv" && grep -qE 'ansible_connection=ssh' "$inv"; then
        arch=hybrid
    fi
    if [[ "$DHIS2_OPT_JSON" == true ]]; then
        dhis2_json_emit command=dhis2-deploy inventory="$inv" architecture="$arch"
    else
        printf 'inventory:   %s\narchitecture: %s\n' "$inv" "$arch"
    fi
}

_components() {
    if [[ "$DHIS2_OPT_JSON" == true ]]; then
        local arr="[" first=true k
        for k in "${!COMPONENT_TAGS[@]}"; do
            $first || arr+=","
            first=false
            arr+="{\"component\":\"$k\",\"tag\":\"${COMPONENT_TAGS[$k]}\"}"
        done
        arr+="]"
        dhis2_json_emit command=dhis2-deploy components="$arr"
    else
        local k rows=() sorted=()
        for k in "${!COMPONENT_TAGS[@]}"; do rows+=("$k|${COMPONENT_TAGS[$k]}"); done
        mapfile -t sorted < <(printf '%s\n' "${rows[@]}" | sort)
        dhis2_output_table "COMPONENT|ANSIBLE TAG" "${sorted[@]}"
    fi
}

_history() {
    local d; d=$(dhis2_config_history_dir)
    if [[ "$DHIS2_OPT_JSON" == true ]]; then
        local arr="[" first=true f
        for f in "$d"/apply.*.log; do
            [[ -f "$f" ]] || continue
            $first || arr+=","
            first=false
            arr+="\"$(basename "$f")\""
        done
        arr+="]"
        dhis2_json_emit command=dhis2-deploy history="$arr"
    else
        ls -1t "$d" 2>/dev/null | head -50 || echo "(no history)"
    fi
}

_resume() {
    dhis2_log_warn "resume is informational: a run that failed should be re-applied with the same --instance and --only once the root cause is resolved."
    _history
}

#
# dhis2-deploy migrate boombox-to-lxd [--dry-run | --execute --yes] [--instance NAME]
#
# Phase 4 of the boombox plan. Converts a running single-host boombox
# to the LXD-containerised layout. Operator-dangerous; three modes:
#
#   default           preflight-only: refuses to run without
#                     --dry-run OR --execute, prints the plan and
#                     exits 0.
#   --dry-run         prints every command that would run, exits 0.
#   --execute --yes   actually runs the migration with per-stage
#                     confirmation gates + typed instance name.
#
# The command performs AUTOMATIC rollback only for pre-destructive
# failures (steps 1-5 below). After step 6 (services stopped), a
# failure hands off to the operator with the exact restore command
# because any further automatic action risks compounding damage.
#
# Audit records at every stage. The command refuses to run on any
# inventory that is not dhis2_architecture=boombox.
#
_migrate() {
    local direction="${1:-}"; shift || true
    [[ -z "$direction" ]] && { dhis2_log_error 'Usage: dhis2-deploy migrate boombox-to-lxd [--dry-run|--execute|detect-drift] [--instance NAME] [--rotate-db-password]'; exit "$DHIS2_EXIT_USAGE"; }
    case "$direction" in
        boombox-to-lxd) ;;
        detect-drift) _migrate_boombox_drift_report "$@"; return ;;
        *) dhis2_log_error "Unsupported migration direction: $direction (only boombox-to-lxd is implemented)"; exit "$DHIS2_EXIT_USAGE" ;;
    esac
    local mode=preflight rotate_db=false
    local -a instances=()
    while (( $# )); do
        case "$1" in
            --dry-run) mode=dry-run ;;
            --execute) mode=execute ;;
            --detect-drift|detect-drift) mode=drift ;;
            --instance) instances+=("$2"); shift ;; --instance=*) instances+=("${1#*=}") ;;
            --rotate-db-password) rotate_db=true ;;
        esac
        shift || true
    done

    local inv; inv=$(dhis2_config_resolve_inventory)

    # Opt-in guard: boombox only.
    if ! grep -qE '^[[:space:]]*dhis2_architecture[[:space:]]*=[[:space:]]*boombox' "$inv"; then
        dhis2_log_error "dhis2-deploy migrate boombox-to-lxd requires dhis2_architecture=boombox in the inventory."
        dhis2_log_error "  Current inventory: $inv"
        exit "$DHIS2_EXIT_PREFLIGHT"
    fi

    # Resolve the instances. Multi-instance boombox migration is now
    # supported: --instance may be passed multiple times, OR the
    # command migrates every instance in [instances] (asking for
    # confirmation when migrating all).
    if (( ${#instances[@]} == 0 )); then
        mapfile -t instances < <(dhis2_inventory_group_hosts instances | grep '[^[:space:]]')
    fi
    if (( ${#instances[@]} == 0 )); then
        dhis2_log_error "No instances found in [instances]"
        exit "$DHIS2_EXIT_USAGE"
    fi

    # The preflight is cluster-wide (not per-instance), so run it once.
    _migrate_boombox_preflight "${instances[0]}" "$inv" "$mode"

    case "$mode" in
        drift)
            _migrate_boombox_drift_report
            ;;
        preflight)
            _migrate_boombox_plan "${instances[@]}"
            dhis2_log_info "Preflight passed. Re-run with --dry-run or --execute --yes."
            ;;
        dry-run)
            _migrate_boombox_plan "${instances[@]}"
            _migrate_boombox_dryrun "${instances[@]}"
            ;;
        execute)
            _migrate_boombox_plan "${instances[@]}"
            if [[ "$DHIS2_OPT_YES" != true ]]; then
                dhis2_log_error "--execute refuses to proceed without --yes."
                dhis2_log_error "  Re-run with: dhis2-deploy migrate boombox-to-lxd --execute --yes$(for i in "${instances[@]}"; do printf ' --instance %s' "$i"; done)"
                exit "$DHIS2_EXIT_SAFETY"
            fi
            local labels; labels=$(IFS=', '; echo "${instances[*]}")
            dhis2_cli_confirm "This migrates ${#instances[@]} instance(s) ($labels) from boombox to LXD. There WILL be downtime (10-30 min typical, +5 min per extra instance). Pre-destructive failures roll back automatically; post-destructive failures hand off to the operator." "boombox-to-lxd"
            _migrate_boombox_execute "$inv" "$rotate_db" "${instances[@]}"
            ;;
    esac
}

#
# Stage 0 - drift detection.
#
# Operators do manual things to boomboxes: edit dhis.conf, upgrade
# tomcat9 to tomcat10, change the PG major, drop custom nginx
# snippets into /etc/nginx/conf.d/, add a systemd override under
# /etc/systemd/system/postgresql.service.d/. The migration must
# notice all of this and either preserve it (nginx snippets,
# systemd overrides) or adapt (tomcat major, PG major, DHIS2
# version) rather than quietly reset to the inventory defaults.
#
# Also exposed as a standalone `dhis2-deploy migrate detect-drift`
# subcommand so operators can inspect before running the migrate.
#
_migrate_boombox_drift_report() {
    _migrate_boombox_detect_drift
    if [[ "$DHIS2_OPT_JSON" == true ]]; then
        dhis2_json_emit command=dhis2-deploy action=detect-drift \
            tomcat_major="${DHIS2_DRIFT_TOMCAT:-?}" \
            pg_major="${DHIS2_DRIFT_PG:-?}" \
            dhis2_version="${DHIS2_DRIFT_DHIS2:-?}" \
            dhis_conf_db_host="${DHIS2_DRIFT_CONF_DB_HOST:-?}" \
            dhis_conf_db_name="${DHIS2_DRIFT_CONF_DB_NAME:-?}" \
            dhis_conf_db_user="${DHIS2_DRIFT_CONF_DB_USER:-?}" \
            nginx_custom_files="${DHIS2_DRIFT_NGINX_FILES:-0}" \
            pg_systemd_overrides="${DHIS2_DRIFT_PG_OVERRIDES:-0}"
    else
        dhis2_c_bold "Detected state (drift report)"; echo
        printf '  tomcat major:               %s\n' "${DHIS2_DRIFT_TOMCAT:-?}"
        printf '  postgresql major:           %s\n' "${DHIS2_DRIFT_PG:-?}"
        printf '  running DHIS2 version:      %s\n' "${DHIS2_DRIFT_DHIS2:-?}"
        printf '  dhis.conf database host:    %s\n' "${DHIS2_DRIFT_CONF_DB_HOST:-?}"
        printf '  dhis.conf database name:    %s\n' "${DHIS2_DRIFT_CONF_DB_NAME:-?}"
        printf '  dhis.conf database user:    %s\n' "${DHIS2_DRIFT_CONF_DB_USER:-?}"
        printf '  nginx custom files:         %s under /etc/nginx/conf.d + /etc/nginx/snippets\n' "${DHIS2_DRIFT_NGINX_FILES:-0}"
        printf '  postgresql systemd override files: %s\n' "${DHIS2_DRIFT_PG_OVERRIDES:-0}"
        echo
        if [[ "${DHIS2_DRIFT_CONF_DB_HOST:-}" != "localhost" && "${DHIS2_DRIFT_CONF_DB_HOST:-}" != "127.0.0.1" ]]; then
            dhis2_c_red "WARNING"; echo " - dhis.conf.database.host is not localhost; migration will refuse unless the drift is resolved"
        fi
        if [[ -n "${DHIS2_DRIFT_TOMCAT:-}" && "${DHIS2_DRIFT_TOMCAT}" != "9" ]]; then
            dhis2_c_yellow "note"; echo " - running Tomcat ${DHIS2_DRIFT_TOMCAT}; the migration will install tomcat${DHIS2_DRIFT_TOMCAT} in the LXD topology"
        fi
    fi
}

# Populate DHIS2_DRIFT_* globals.
_migrate_boombox_detect_drift() {
    DHIS2_DRIFT_TOMCAT=""
    DHIS2_DRIFT_PG=""
    DHIS2_DRIFT_DHIS2=""
    DHIS2_DRIFT_CONF_DB_HOST=""
    DHIS2_DRIFT_CONF_DB_NAME=""
    DHIS2_DRIFT_CONF_DB_USER=""
    DHIS2_DRIFT_NGINX_FILES=0
    DHIS2_DRIFT_PG_OVERRIDES=0

    # Tomcat major: prefer the one with a running unit; fall back to
    # the one whose data_directory contains deployed webapps.
    local t
    for t in 9 10 11; do
        if systemctl is-active --quiet "tomcat${t}" 2>/dev/null; then
            DHIS2_DRIFT_TOMCAT="$t"
            break
        fi
    done
    if [[ -z "$DHIS2_DRIFT_TOMCAT" ]]; then
        for t in 9 10 11; do
            if [[ -d "/var/lib/tomcat${t}/webapps" ]] && ls "/var/lib/tomcat${t}/webapps"/*.war >/dev/null 2>&1; then
                DHIS2_DRIFT_TOMCAT="$t"
                break
            fi
        done
    fi

    # PostgreSQL major from /etc/postgresql/<major>/main
    local pg_dir
    pg_dir=$(ls -d /etc/postgresql/*/main 2>/dev/null | head -1)
    if [[ -n "$pg_dir" ]]; then
        DHIS2_DRIFT_PG=$(echo "$pg_dir" | awk -F/ '{print $4}')
    fi

    # DHIS2 version from the WAR MANIFEST.MF
    local war
    war=$(find /var/lib/tomcat*/webapps -name 'MANIFEST.MF' 2>/dev/null | head -1)
    if [[ -n "$war" ]]; then
        DHIS2_DRIFT_DHIS2=$(awk -F': *' '/^Implementation-Version/ {print $2; exit}' "$war" 2>/dev/null | tr -d '\r')
    fi

    # dhis.conf parse (host/db/user). Secrets are NOT read.
    if [[ -r /opt/dhis2/dhis.conf ]]; then
        local url
        url=$(awk -F'=' '/^[[:space:]]*connection\.url[[:space:]]*=/ {gsub(/^[[:space:]]+|[[:space:]]+$/, "", $2); print $2; exit}' /opt/dhis2/dhis.conf)
        # jdbc:postgresql://HOST/DB
        if [[ "$url" =~ jdbc:postgresql://([^/:]+)(:[0-9]+)?/([a-zA-Z0-9_-]+) ]]; then
            DHIS2_DRIFT_CONF_DB_HOST="${BASH_REMATCH[1]}"
            DHIS2_DRIFT_CONF_DB_NAME="${BASH_REMATCH[3]}"
        fi
        DHIS2_DRIFT_CONF_DB_USER=$(awk -F'=' '/^[[:space:]]*connection\.username[[:space:]]*=/ {gsub(/^[[:space:]]+|[[:space:]]+$/, "", $2); print $2; exit}' /opt/dhis2/dhis.conf)
    fi

    # Custom nginx files (operator-added; the role manages conf.d/upstream/ only).
    DHIS2_DRIFT_NGINX_FILES=$(find /etc/nginx/conf.d /etc/nginx/snippets -maxdepth 1 -type f -name '*.conf' 2>/dev/null \
        | grep -vE '/(upstream|dhis2-server-tools)' | wc -l | tr -d ' ')

    # Postgresql systemd overrides.
    DHIS2_DRIFT_PG_OVERRIDES=$(find /etc/systemd/system/postgresql.service.d -maxdepth 1 -type f -name '*.conf' 2>/dev/null | wc -l | tr -d ' ')
}

_migrate_boombox_preflight() {
    local inv="$2" mode="$3"   # $1 is a representative instance (unused here)
    local findings=()

    # Stage 0 - drift detection runs first so later checks can use
    # the detected Tomcat major / dhis.conf host / etc.
    _migrate_boombox_detect_drift

    # 0a. dhis.conf must resolve the DB locally. If the operator pointed
    # it at a different host, we refuse to migrate until the drift is
    # resolved (because the LXD topology moves the DB into a container).
    case "${DHIS2_DRIFT_CONF_DB_HOST:-}" in
        ""|localhost|127.0.0.1|127\.*|::1) ;;  # OK
        *)
            findings+=("dhis.conf points at '${DHIS2_DRIFT_CONF_DB_HOST}', not localhost. The migrate command targets a boombox (local PG). Investigate and set connection.url to a local URL before migrating.")
            ;;
    esac

    # 1. boombox-mode preflight already OK? Rerun it to catch new issues.
    local out rc=0
    out=$("$0" preflight 2>&1) || rc=$?
    if (( rc != 0 )); then
        findings+=("boombox preflight is not green (rc=$rc). Fix issues from 'dhis2-deploy preflight' before migrating.")
    fi

    # 2. Services expected to be running. Honour the detected Tomcat major.
    local svc tomcat_svc="tomcat${DHIS2_DRIFT_TOMCAT:-9}"
    for svc in postgresql "$tomcat_svc" nginx; do
        if ! systemctl is-active --quiet "$svc" 2>/dev/null; then
            findings+=("service $svc is not active - the migration starts from a running boombox")
        fi
    done

    # 3. Disk headroom: 2x current DB footprint (backup + new LXD).
    local pg_mb free_mb
    pg_mb=$(du -sm /var/lib/postgresql 2>/dev/null | awk '{print $1}')
    free_mb=$(df -m / | awk 'NR==2 {print $4}')
    if [[ -n "$pg_mb" && -n "$free_mb" ]] && (( free_mb < pg_mb * 2 )); then
        findings+=("insufficient disk: /var/lib/postgresql is ${pg_mb} MiB but / only has ${free_mb} MiB free (need >= 2x = $(( pg_mb * 2 )) MiB)")
    fi

    # 4. apt / lxd package availability.
    if ! command -v apt-get >/dev/null; then
        findings+=("apt-get not available - this migration targets Ubuntu")
    fi
    if ! command -v lxd >/dev/null 2>&1 && ! apt-cache show lxd >/dev/null 2>&1; then
        findings+=("lxd package not available via apt")
    fi

    # Report
    if (( ${#findings[@]} )); then
        dhis2_c_red "FAIL"; echo " - migrate boombox-to-lxd preflight has blockers:"
        local f
        for f in "${findings[@]}"; do printf '  - %s\n' "$f"; done
        exit "$DHIS2_EXIT_PREFLIGHT"
    fi
    [[ "$mode" == "preflight" ]] && { dhis2_status_ok "OK"; echo " - migrate boombox-to-lxd preflight passed"; }
}

_migrate_boombox_plan() {
    local -a instances=("$@")
    local pg_mb; pg_mb=$(du -sm /var/lib/postgresql 2>/dev/null | awk '{print $1}')
    local tomcat="${DHIS2_DRIFT_TOMCAT:-9}"
    local ts; ts=$(date -u +%Y%m%d-%H%M%S)
    cat <<EOF

migrate boombox-to-lxd
  instance(s):      $(IFS=,; echo "${instances[*]}")
  current PG size:  ${pg_mb:-?} MiB
  detected tomcat:  tomcat${tomcat}
  detected pg:      ${DHIS2_DRIFT_PG:-16}
  detected DHIS2:   ${DHIS2_DRIFT_DHIS2:-?}
  dhis.conf db:     host=${DHIS2_DRIFT_CONF_DB_HOST:-?} name=${DHIS2_DRIFT_CONF_DB_NAME:-?} user=${DHIS2_DRIFT_CONF_DB_USER:-?}
  custom nginx:     ${DHIS2_DRIFT_NGINX_FILES:-0} file(s) will be preserved
  pg systemd ovr:   ${DHIS2_DRIFT_PG_OVERRIDES:-0} file(s) will be preserved
  backup target:    /var/backups/dhis2/<instance>-pre-migrate-${ts}.dump

Stages (per-stage confirmation when --execute):

  1  snapshot inventory + /opt/dhis2/dhis.conf + nginx config
     + /etc/systemd/system/postgresql.service.d + custom nginx snippets
  2  for each instance: dhis2-backup create --format custom --verify
  3  dhis2-instance maintenance <inst> enable      (nginx 503 per instance)
  4  systemctl stop tomcat${tomcat} nginx          (user-visible stop)
  5  systemctl stop postgresql                     (destructive stop)
  >>>>>>> after this point rollback is operator-driven <<<<<<<
  6  apt install -y lxd lxd-client ; lxd init --preseed
  7  rewrite inventory: dhis2_architecture=lxd, ansible_connection=lxd,
     tomcat_version=${tomcat}, postgresql_version=${DHIS2_DRIFT_PG:-16},
     container IPs for proxy/postgres/each-instance/monitor
  8  dhis2-deploy apply                            (install stack in LXD)
  9  for each instance:
       dhis2-restore database --backup <per-instance.dump> --instance <inst>
         --drop-existing --create-db --reassign-owner --verify --yes
 10  for each instance: lxc file push -r /opt/dhis2/files -> container
      + lxc file push /etc/nginx/conf.d/<custom>.conf -> proxy container
      + preserve /etc/systemd/system/postgresql.service.d overrides into
        the postgres container
 11  for each instance: dhis2-instance maintenance <inst> disable
 12  for each instance: dhis2-instance health <inst> --retry 30 --interval 10
       --expect-version ${DHIS2_DRIFT_DHIS2:-configured}
 13  dhis2-doctor                                  (post-migration state)
     + optional: dhis2-vault rotate-db-password <inst>  (when --rotate-db-password)

Rollback window:
  pre-destructive (1-5)  automatic rollback: services restarted,
                         inventory restored, maintenance disabled
  post-destructive (6+)  operator-driven: restore from the per-
                         instance backup under /var/backups/dhis2
                         on a fresh host, documented in
                         docs/Boombox-to-LXD-Migration.md section
                         "Rollback after step 6"

EOF
}

_migrate_boombox_dryrun() {
    local -a instances=("$@")
    local tomcat="${DHIS2_DRIFT_TOMCAT:-9}"
    local ts; ts=$(date -u +%Y%m%d-%H%M%S)
    cat <<EOF
# dry-run - commands that would be executed:

# Stage 1 - state snapshot (including custom nginx + systemd overrides)
snap=/var/lib/dhis2-server-tools/snapshots/migrate-boombox-${ts}
mkdir -p "\$snap"
cp -p \${DHIS2_INVENTORY} "\$snap/hosts"
cp -p /opt/dhis2/dhis.conf "\$snap/dhis.conf"
cp -r /etc/nginx/                            "\$snap/nginx/"
cp -r /etc/systemd/system/postgresql.service.d "\$snap/pg-systemd-override/" 2>/dev/null || true
cp -p /etc/postgresql/*/main/postgresql.conf "\$snap/"

# Stage 2 - verified backup (one dump per instance)
EOF
    local i
    for i in "${instances[@]}"; do
        printf 'dhis2-backup create %s --format custom --out /var/backups/dhis2 --yes\n' "$i"
        printf 'dhis2-backup verify /var/backups/dhis2/%s-pre-migrate-%s.dump\n' "$i" "$ts"
    done
    cat <<EOF

# Stage 3 - maintenance mode on (per instance)
EOF
    for i in "${instances[@]}"; do
        printf 'dhis2-instance maintenance %s enable\n' "$i"
    done
    cat <<EOF

# Stage 4-5 - stop services (destructive from step 5)
systemctl stop tomcat${tomcat}
systemctl stop nginx
sudo -u postgres psql -X -c CHECKPOINT
systemctl stop postgresql

# Stage 6 - install LXD
apt-get update -q
apt-get install -y lxd lxd-client
lxd init --preseed <<<'config:
  core.https_address: 127.0.0.1:8443
networks:
- name: lxdbr0
  type: bridge
  config:
    ipv4.address: auto
    ipv6.address: none
storage_pools:
- name: default
  driver: dir
profiles:
- name: default
  devices:
    eth0: { nictype: bridged, parent: lxdbr0, type: nic }
    root: { pool: default, path: /, type: disk }
'

# Stage 7 - rewrite inventory
#   dhis2_architecture=lxd
#   ansible_connection=lxd
#   tomcat_version=${tomcat}  postgresql_version=${DHIS2_DRIFT_PG:-16}
#   proxy -> 172.19.2.2
#   postgres -> 172.19.2.20
#   monitor -> 172.19.2.30
#   per instance:
EOF
    local idx=0 i
    for i in "${instances[@]}"; do
        idx=$((idx+1))
        printf '#     %s -> 172.19.2.1%s\n' "$i" "$idx"
    done
    cat <<EOF

# Stage 8 - apply the LXD stack
dhis2-deploy apply --yes

# Stage 9 - restore DB into each instance's new postgres container
EOF
    for i in "${instances[@]}"; do
        printf 'dhis2-restore database \\\n    --backup /var/backups/dhis2/%s-pre-migrate-%s.dump \\\n    --instance %s \\\n    --drop-existing --create-db --reassign-owner --verify --yes\n' "$i" "$ts" "$i"
    done
    cat <<EOF

# Stage 10 - DHIS2 files + preserved custom nginx + pg systemd overrides
EOF
    for i in "${instances[@]}"; do
        printf 'lxc file push -r /opt/dhis2/files/ %s/opt/dhis2/ 2>/dev/null || true\n' "$i"
    done
    cat <<'EOF'
for f in /etc/nginx/conf.d/*.conf /etc/nginx/snippets/*.conf; do
    [ -f "$f" ] || continue
    case "$f" in */upstream/*|*dhis2-server-tools*) continue ;; esac
    lxc file push "$f" "proxy${f}"
done
if [ -d /etc/systemd/system/postgresql.service.d ]; then
    lxc exec postgres -- mkdir -p /etc/systemd/system/postgresql.service.d
    for f in /etc/systemd/system/postgresql.service.d/*.conf; do
        [ -f "$f" ] || continue
        lxc file push "$f" "postgres${f}"
    done
    lxc exec postgres -- systemctl daemon-reload
fi

# Stage 11 - disable maintenance (per instance)
EOF
    for i in "${instances[@]}"; do
        printf 'dhis2-instance maintenance %s disable\n' "$i"
    done
    cat <<EOF

# Stage 12 - end-to-end health (per instance)
EOF
    for i in "${instances[@]}"; do
        printf 'dhis2-instance health %s --retry 30 --interval 10\n' "$i"
    done
    cat <<EOF

# Stage 13 - operational snapshot
dhis2-doctor snapshot

# Optional - rotate DB password (when --rotate-db-password):
EOF
    for i in "${instances[@]}"; do
        printf '# dhis2-vault rotate-db-password %s --yes\n' "$i"
    done
    cat <<'EOF'

EOF
}

_migrate_boombox_execute() {
    local inv="$1" rotate_db="$2"; shift 2
    local -a instances=("$@")
    local tomcat="${DHIS2_DRIFT_TOMCAT:-9}"
    local pg_major="${DHIS2_DRIFT_PG:-16}"
    local ts; ts=$(date -u +%Y%m%d-%H%M%S)
    local snap_dir="/var/lib/dhis2-server-tools/snapshots/migrate-boombox-${ts}"
    local -A backup_paths
    local i

    for i in "${instances[@]}"; do
        backup_paths["$i"]="/var/backups/dhis2/${i}-pre-migrate-${ts}.dump"
    done

    dhis2_log_audit dhis2-deploy "{\"action\":\"migrate-boombox-to-lxd\",\"instances\":\"$(IFS=,; echo "${instances[*]}")\",\"stage\":\"start\",\"tomcat\":\"$tomcat\",\"pg\":\"$pg_major\"}" "started"

    # Stage 1 - snapshot (reversible). Also stashes custom nginx snippets
    # and systemd overrides so stage 10 can push them into the LXD
    # containers.
    dhis2_log_info "Stage 1 - state snapshot -> $snap_dir"
    mkdir -p "$snap_dir/preserve/nginx-conf.d" "$snap_dir/preserve/nginx-snippets" "$snap_dir/preserve/pg-systemd" && chmod -R 700 "$snap_dir"
    cp -p "$inv" "$snap_dir/hosts"
    [[ -f /opt/dhis2/dhis.conf ]] && cp -p /opt/dhis2/dhis.conf "$snap_dir/dhis.conf"
    [[ -d /etc/nginx ]] && cp -a /etc/nginx "$snap_dir/nginx"
    find /etc/postgresql -name postgresql.conf -exec cp -p {} "$snap_dir/" \; 2>/dev/null || true

    # Preservation: operator-authored files only. The project-managed
    # files under /etc/nginx/conf.d/upstream/ and dhis2-server-tools-named
    # files are regenerated by the role; preserving them would conflict.
    local f
    while IFS= read -r f; do
        [[ -z "$f" ]] && continue
        cp -p "$f" "$snap_dir/preserve/nginx-conf.d/"
    done < <(find /etc/nginx/conf.d -maxdepth 1 -type f -name '*.conf' 2>/dev/null | grep -vE '/(upstream|dhis2-server-tools)')
    while IFS= read -r f; do
        [[ -z "$f" ]] && continue
        cp -p "$f" "$snap_dir/preserve/nginx-snippets/"
    done < <(find /etc/nginx/snippets -maxdepth 1 -type f -name '*.conf' 2>/dev/null | grep -vE '/(dhis2-server-tools)')
    while IFS= read -r f; do
        [[ -z "$f" ]] && continue
        cp -p "$f" "$snap_dir/preserve/pg-systemd/"
    done < <(find /etc/systemd/system/postgresql.service.d -maxdepth 1 -type f -name '*.conf' 2>/dev/null)

    # Stage 2 - verified backup, per instance (reversible)
    for i in "${instances[@]}"; do
        dhis2_log_info "Stage 2 - verified backup for $i"
        "${DHIS2_CLI_ROOT}/bin/dhis2-backup" create "$i" --format custom --out /var/backups/dhis2 --yes \
            || _migrate_boombox_rollback_pre "$snap_dir" "${instances[*]}" "backup-create failed for $i"
        "${DHIS2_CLI_ROOT}/bin/dhis2-backup" verify "${backup_paths[$i]}" \
            || _migrate_boombox_rollback_pre "$snap_dir" "${instances[*]}" "backup-verify failed for $i"
    done

    # Stage 3 - maintenance (reversible), per instance
    for i in "${instances[@]}"; do
        dhis2_log_info "Stage 3 - maintenance mode on for $i"
        "${DHIS2_CLI_ROOT}/bin/dhis2-instance" maintenance "$i" enable --yes \
            || _migrate_boombox_rollback_pre "$snap_dir" "${instances[*]}" "maintenance enable failed for $i"
    done

    # Stage 4-5 - stop services (destructive from step 5). Honour the
    # detected Tomcat major so a 9->10 upgrade boombox stops the right
    # unit.
    dhis2_log_info "Stage 4-5 - stopping tomcat${tomcat} / nginx / postgresql"
    systemctl stop "tomcat${tomcat}" nginx 2>/dev/null || true
    sudo -u postgres psql -X -c "CHECKPOINT" >/dev/null 2>&1 || true
    if ! systemctl stop postgresql 2>/dev/null; then
        _migrate_boombox_rollback_pre "$snap_dir" "${instances[*]}" "systemctl stop postgresql failed"
    fi
    dhis2_log_audit dhis2-deploy "{\"action\":\"migrate-boombox-to-lxd\",\"stage\":\"destructive-point\",\"snap\":\"$snap_dir\"}" "destructive-point"
    dhis2_log_warn ">>> entering post-destructive stages 6-13. Automatic rollback is NOT available past this point."

    # Stage 6 - install LXD
    dhis2_log_info "Stage 6 - installing LXD"
    if ! { apt-get update -q && apt-get install -y lxd lxd-client; }; then
        _migrate_boombox_operator_restore "${instances[*]}" "$snap_dir" "stage 6 (lxd install) failed"
    fi

    # Stage 7 - rewrite inventory with the detected tomcat major +
    # PG major + per-instance IPs.
    dhis2_log_info "Stage 7 - rewrite inventory for LXD topology"
    local new_inv="$snap_dir/hosts.lxd"
    _migrate_boombox_render_lxd_inventory "$tomcat" "$pg_major" "${instances[@]}" > "$new_inv"
    if ! "${DHIS2_CLI_ROOT}/bin/dhis2-inventory" restore "$new_inv"; then
        _migrate_boombox_operator_restore "${instances[*]}" "$snap_dir" "stage 7 (inventory rewrite) failed"
    fi

    # Stage 8 - apply LXD stack
    dhis2_log_info "Stage 8 - deploy stack into LXD"
    if ! "${DHIS2_CLI_ROOT}/bin/dhis2-deploy" apply --yes; then
        _migrate_boombox_operator_restore "${instances[*]}" "$snap_dir" "stage 8 (apply) failed"
    fi

    # Stage 9 - restore DB per instance
    for i in "${instances[@]}"; do
        dhis2_log_info "Stage 9 - restore pre-migrate dump for $i"
        if ! "${DHIS2_CLI_ROOT}/bin/dhis2-restore" database \
                --backup "${backup_paths[$i]}" --instance "$i" \
                --drop-existing --create-db --reassign-owner --verify --yes; then
            _migrate_boombox_operator_restore "${instances[*]}" "$snap_dir" "stage 9 (restore for $i) failed"
        fi
    done

    # Stage 10 - files + preservation (nginx snippets + pg systemd overrides)
    dhis2_log_info "Stage 10 - DHIS2 files + custom nginx + pg systemd overrides"
    for i in "${instances[@]}"; do
        if [[ -d /opt/dhis2/files ]]; then
            lxc file push -r /opt/dhis2/files "${i}/opt/dhis2/" 2>/dev/null || \
                dhis2_log_warn "lxc file push for $i did not succeed; copy /opt/dhis2/files manually."
        fi
    done
    # Preserved operator files
    for f in "$snap_dir"/preserve/nginx-conf.d/*.conf "$snap_dir"/preserve/nginx-snippets/*.conf; do
        [[ -f "$f" ]] || continue
        local base; base=$(basename "$f")
        local kind; kind=$(basename "$(dirname "$f")" | sed 's/^nginx-//')
        lxc file push "$f" "proxy/etc/nginx/${kind}/${base}" 2>/dev/null || dhis2_log_warn "preserve: pushing $f failed"
    done
    for f in "$snap_dir"/preserve/pg-systemd/*.conf; do
        [[ -f "$f" ]] || continue
        local base; base=$(basename "$f")
        lxc exec postgres -- mkdir -p /etc/systemd/system/postgresql.service.d 2>/dev/null || true
        lxc file push "$f" "postgres/etc/systemd/system/postgresql.service.d/${base}" 2>/dev/null || dhis2_log_warn "preserve: pushing $f failed"
    done
    if ls "$snap_dir"/preserve/pg-systemd/*.conf >/dev/null 2>&1; then
        lxc exec postgres -- systemctl daemon-reload 2>/dev/null || true
        lxc exec postgres -- systemctl restart postgresql 2>/dev/null || true
    fi

    # Stage 11 - disable maintenance per instance
    for i in "${instances[@]}"; do
        dhis2_log_info "Stage 11 - maintenance mode off for $i"
        "${DHIS2_CLI_ROOT}/bin/dhis2-instance" maintenance "$i" disable --yes || true
    done

    # Stage 12 - health per instance
    for i in "${instances[@]}"; do
        dhis2_log_info "Stage 12 - health for $i"
        if ! "${DHIS2_CLI_ROOT}/bin/dhis2-instance" health "$i" --retry 30 --interval 10; then
            dhis2_log_error "Health check failed for $i. Investigate; backups are in /var/backups/dhis2/."
            exit "$DHIS2_EXIT_HEALTH"
        fi
    done

    # Stage 13 - operational snapshot + optional DB password rotation
    dhis2_log_info "Stage 13 - operational snapshot"
    "${DHIS2_CLI_ROOT}/bin/dhis2-doctor" snapshot >/dev/null 2>&1 || true
    if [[ "$rotate_db" == "true" ]]; then
        for i in "${instances[@]}"; do
            dhis2_log_info "Stage 13 - rotating DB password for $i (transactional)"
            "${DHIS2_CLI_ROOT}/bin/dhis2-vault" rotate-db-password "$i" --yes \
                || dhis2_log_warn "DB password rotation for $i FAILED; the migration is otherwise complete. Re-run 'dhis2-vault rotate-db-password $i' manually."
        done
    fi

    dhis2_log_audit dhis2-deploy "{\"action\":\"migrate-boombox-to-lxd\",\"stage\":\"done\",\"snap\":\"$snap_dir\"}" "ok"
    dhis2_log_info "Migration complete. Pre-migration backups are retained under /var/backups/dhis2 - keep them until the LXD deployment is confirmed healthy."
}

_migrate_boombox_rollback_pre() {
    local snap_dir="$1" instances_csv="$2" reason="$3"
    dhis2_log_error "Pre-destructive rollback: $reason"
    local tomcat="${DHIS2_DRIFT_TOMCAT:-9}"
    systemctl start postgresql     2>/dev/null || true
    systemctl start "tomcat${tomcat}" 2>/dev/null || true
    systemctl start nginx          2>/dev/null || true
    local i; for i in $instances_csv; do
        "${DHIS2_CLI_ROOT}/bin/dhis2-instance" maintenance "$i" disable --yes 2>/dev/null || true
    done
    dhis2_log_audit dhis2-deploy "{\"action\":\"migrate-boombox-to-lxd\",\"stage\":\"rollback-pre\",\"reason\":\"$reason\",\"snapshot\":\"$snap_dir\"}" "rollback"
    exit "$DHIS2_EXIT_FAILURE"
}

_migrate_boombox_operator_restore() {
    local instances_csv="$1" snap_dir="$2" reason="$3"
    dhis2_log_error "Post-destructive failure: $reason"
    dhis2_log_error "Automatic rollback is NOT safe past the destructive point."
    dhis2_log_error ""
    dhis2_log_error "Operator-driven recovery:"
    dhis2_log_error "  1. Decide: fix forward (continue to LXD) OR fresh host (restore boombox)."
    dhis2_log_error "  2. Per-instance pre-migration dumps are under /var/backups/dhis2/*-pre-migrate-*.dump"
    dhis2_log_error "  3. Full snapshot (inventory, dhis.conf, nginx, pg-config): $snap_dir"
    dhis2_log_error "  4. See docs/Boombox-to-LXD-Migration.md section 'Rollback after step 6'."
    dhis2_log_audit dhis2-deploy "{\"action\":\"migrate-boombox-to-lxd\",\"stage\":\"operator-restore\",\"reason\":\"$reason\",\"snap\":\"$snap_dir\",\"instances\":\"$instances_csv\"}" "handoff"
    exit "$DHIS2_EXIT_FAILURE"
}

_migrate_boombox_render_lxd_inventory() {
    local tomcat="$1" pg_major="$2"; shift 2
    local -a instances=("$@")
    cat <<EOF
#
# Generated by dhis2-deploy migrate boombox-to-lxd on $(date -u +%FT%TZ).
# Original boombox inventory is preserved under the migration snapshot.
#
# Detected during migration:
#   tomcat major:      $tomcat
#   postgresql major:  $pg_major
#   instances:         $(IFS=,; echo "${instances[*]}")
#
[web]
proxy  ansible_host=172.19.2.2

[databases]
postgres  ansible_host=172.19.2.20

[instances]
EOF
    local idx=0 i
    for i in "${instances[@]}"; do
        idx=$((idx+1))
        printf '%s  ansible_host=172.19.2.1%d  database_host=postgres  dhis2_version=%s\n' \
            "$i" "$idx" "${DHIS2_DRIFT_DHIS2:-2.43}"
    done
    cat <<EOF

[monitoring]
monitor  ansible_host=172.19.2.30

[backup_servers]
backup   ansible_host=172.19.2.100

[all:vars]
dhis2_architecture=lxd
ansible_connection=lxd
tomcat_version=$tomcat
postgresql_version=$pg_major
EOF
}

main "$@"
