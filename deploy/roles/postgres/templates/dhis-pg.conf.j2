# WARNING: This file is automatically generated by an Ansible template.
# Any custom modifications made directly to this file will be overwritten
# during future Ansible runs.

# Please place any custom configurations in the following file

# /etc/postgresql/{{ postgresql_version }}/main/conf.d/custom
# configurations within that file will be included at the end of this file and will take precedence 

# Adjust depending on number of DHIS2 instances and their pool size
# By default each instance requires up to 80 connections
# This might be different if you have set pool in dhis.conf
password_encryption = scram-sha-256
# max_connections = 200 
{% if pg_max_connections is defined and pg_max_connections | regex_search('\d+') %}
max_connections = {{ pg_max_connections }}
{% else %}
max_connections = 200
{% endif %}

# Tune these according to your environment
# About 25% available RAM for postgres
# shared_buffers = 3GB
{% if pg_shared_buffers is defined and pg_shared_buffers | regex_search('^\d+(GB|MB|KB)$') %}
shared_buffers = {{ pg_shared_buffers }}
{% endif %}

# Multiply by max_connections to know potentially how much RAM is required
# work_mem=20MB
{% if pg_work_mem is defined and  pg_work_mem | regex_search('^\d+(GB|MB|KB)$') %}
work_mem = {{ pg_work_mem }}
{% endif %}

# As much as you can reasonably afford.  Helps with index generation 
# during the analytics generation task
# maintenance_work_mem=512MB
{% if pg_maintenance_work_mem is defined and pg_maintenance_work_mem | regex_search('^\d+(GB|MB|KB)$') %}
maintenance_work_mem = {{ pg_maintenance_work_mem }}
{% endif %}

# Approx 80% of (Available RAM - maintenance_work_mem - max_connections*work_mem)
# effective_cache_size=8GB
{% if pg_effective_cache_size is defined and pg_effective_cache_size | regex_search('^\d+(GB|MB|KB)$') %}
effective_cache_size = {{ pg_effective_cache_size }}
{% endif %}

checkpoint_completion_target = 0.8
synchronous_commit = off
wal_writer_delay = 10000ms
random_page_cost = 1.1
log_min_duration_statement = 300s

#
# WAL retention bounds. See docs/CLI-WAL-Operations.md and
# docs/vital-enhancements/wal-disk-safety-plan.md. These exist so a
# surprise ETL job or a stalled archiver cannot grow pg_wal unbounded.
# Operators tuning for heavy write workloads should raise max_wal_size
# and the alert threshold together.
#
# max_wal_size is a SOFT target - PG may exceed it under sustained
# write pressure, but at that point checkpoints are triggered more
# aggressively. min_wal_size prevents too-aggressive recycling.
#
{% if pg_max_wal_size is defined and pg_max_wal_size | regex_search('^\d+(GB|MB|KB)$') %}
max_wal_size = {{ pg_max_wal_size }}
{% else %}
max_wal_size = 4GB
{% endif %}
{% if pg_min_wal_size is defined and pg_min_wal_size | regex_search('^\d+(GB|MB|KB)$') %}
min_wal_size = {{ pg_min_wal_size }}
{% else %}
min_wal_size = 80MB
{% endif %}
{% if pg_checkpoint_timeout is defined and pg_checkpoint_timeout | regex_search('^\d+(min|s|h)$') %}
checkpoint_timeout = {{ pg_checkpoint_timeout }}
{% endif %}
# wal_keep_size - with replication slots this stays 0; the slot does
# the retention. See PG16 runtime-config-replication.
wal_keep_size = {{ pg_wal_keep_size | default(0) }}

# max_slot_wal_keep_size - HARD cap on WAL that replication slots can
# retain. Compliance: unlimited (-1) is refused by the preflight.
# See PG16 runtime-config-replication.
max_slot_wal_keep_size = {{ pg_max_slot_wal_keep_size | default('10GB') }}

# log_checkpoints - essential for diagnosing WAL pressure.
log_checkpoints = {{ pg_log_checkpoints | default('on') }}

#
# WAL archive. Default off (same as the current single-node
# deployment). When enabled, the role's wal-archive-preflight.yml runs
# the archive_command against a test file and refuses to proceed if
# it fails - preventing a stuck archive from filling pg_wal.
#
{% if pg_archive_mode | default('off') == 'on' %}
archive_mode = on
archive_command = '{{ pg_archive_command }}'
# archive_timeout bounds the archive lag - WAL is force-switched
# every N seconds even if the segment is not full. See PG16
# runtime-config-wal.
archive_timeout = {{ pg_archive_timeout | default('60s') }}
# wal_level >= replica is required when archive_mode=on
wal_level = {{ pg_wal_level | default('replica') }}
{% endif %}

# This is required for DHIS2.32+
max_locks_per_transaction = 128

# This is required if you are running PI on pg 12+ 
{% if postgresql_version > 10 %}
jit = off 
{% endif %}

include_if_exists = custom
