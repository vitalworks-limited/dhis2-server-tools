#
# haproxy-pg.cfg - managed by dhis2-server-tools / roles/haproxy-pg.
# Do not edit by hand.
#
# Writes go to :{{ ha_pg_lb_write_port }} and are routed to whichever
# PG node Patroni currently calls the leader (HTTP 200 on /leader).
# Reads go to :{{ ha_pg_lb_read_port }} and are load-balanced across
# nodes returning HTTP 200 on /replica. When no replicas are up the
# primary answers /replica too, so there is always a target.
#

global
    log /dev/log {{ ha_pg_haproxy_log_facility }}
    maxconn 1024
    user {{ ha_pg_haproxy_user }}
    group {{ ha_pg_haproxy_user }}
    stats socket {{ ha_pg_haproxy_stats_socket }} mode 660 level admin expose-fd listeners
    stats timeout 2m

defaults
    log global
    mode tcp
    option tcplog
    option dontlognull
    timeout connect 5s
    timeout client  1h
    timeout server  1h
    timeout check   5s
    retries 3

listen stats
    bind 127.0.0.1:7000
    mode http
    stats enable
    stats uri /
    stats refresh 5s

listen postgres-write
    bind *:{{ ha_pg_lb_write_port }}
    mode tcp
    option httpchk GET /leader
    http-check expect status 200
    default-server inter {{ ha_pg_check_inter }} fall {{ ha_pg_check_fall }} rise {{ ha_pg_check_rise }} on-marked-down shutdown-sessions
{% for h in ha_pg_candidates %}
    server {{ h }} {{ hostvars[h]['ansible_default_ipv4']['address'] | default(hostvars[h]['ansible_host']) }}:5432 check port {{ ha_pg_patroni_rest_port }}
{% endfor %}

listen postgres-read
    bind *:{{ ha_pg_lb_read_port }}
    mode tcp
    balance leastconn
    option httpchk GET /replica
    http-check expect status 200
    default-server inter {{ ha_pg_check_inter }} fall {{ ha_pg_check_fall }} rise {{ ha_pg_check_rise }}
{% for h in ha_pg_candidates %}
    server {{ h }} {{ hostvars[h]['ansible_default_ipv4']['address'] | default(hostvars[h]['ansible_host']) }}:5432 check port {{ ha_pg_patroni_rest_port }}
{% endfor %}
